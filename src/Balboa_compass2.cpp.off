
#include <Wire.h>
#include <LIS3MDL.h>
#include <LSM6.h>

// mods by S. James Remington
#include "vector.c"
// last update 6/1/2018
/*
   Tilt compensated compass by Pololu engineers, with mods by SJR
   magnetic North is opposite the wheels when Balboa is horizontal
*/
vector p = {1, 0, 0};

LSM6 imu;
LIS3MDL mag;

char report[80];

// Code initialization statements from magneto
// required to correct magnetometer distortion
// for details see https://forum.pololu.com/t/correcting-the-balboa-magnetometer/14315

//float B[3] = { 9955.15, -7948.26, 8511.80};

float B[3] = { 32768, -32768, 32768};


float Ainv[3][3] = {{  0.25060,  0.02942, -0.02955},
  {  0.02942,  0.31692,  0.00789},
  { -0.02955,  0.00789,  0.30592}
};

void setupCompass()
{


  if (!mag.init())
  {
    Serial.println(F("Failed to detect and initialize magnetometer!"));
    while (1);
  }

  mag.enableDefault();
  if (!imu.init())
  {
    // Failed to detect the IMU
    Serial.println(F("Failed to detect the LSM6."));
    while (1);
  }

  imu.enableDefault();
}

// Returns a set of scaled magnetic readings from the LIS3MDL
void read_data(vector * m)
{
  static float x, y, z;
  mag.read();
  x = mag.m.x - B[0];
  y = mag.m.y - B[1];
  z = mag.m.z - B[2];
  m->x = Ainv[0][0] * x + Ainv[0][1] * y + Ainv[0][2] * z;
  m->y = Ainv[1][0] * x + Ainv[1][1] * y + Ainv[1][2] * z;
  m->z = Ainv[2][0] * x + Ainv[2][1] * y + Ainv[2][2] * z;
}

// Returns a heading (in degrees) given an acceleration vector a due to gravity, a magnetic vector m, and a facing vector p (global).
int get_heading(const vector * a, const vector * m)
{
  vector E;
  vector N;

  // D X M = E, cross acceleration vector Down with M (magnetic north + inclination) to produce "East"
  vector_cross(m, a, &E); //Balboa: acc vector is Up when horizontal
  vector_normalize(&E);

  // E X D = N, cross "East" with "Down" to produce "North" (parallel to the ground)
  vector_cross(a, &E, &N);  //on Balboa: Up x East
  vector_normalize(&N);

  // compute heading, get Y and X components of heading from E dot p and N dot p
  int heading = round(atan2(vector_dot(&E, &p), vector_dot(&N, &p)) * 180 / M_PI);
  if (heading < 0)
    heading += 360;
  return heading;
}

 /*
    //   for the curious...

 */

void printHeading() {
  static time_t last = 0;
  time_t now = millis();

  if(now > last + 500) {
    last = now;
    vector a, m;
    int heading;
    float scl=1./16384.; //1 g
    read_data(&m);

    imu.read();
    // normalize accelerometer data. Offsets and scale were determined to be negligible
    a.x = imu.a.x*scl;
    a.y = imu.a.y*scl;
    a.z = imu.a.z*scl;

    heading = get_heading(&a, &m);
    Serial.printf("heading %d\n", heading);
    Serial.print(m.x);
    Serial.print(", ");
    Serial.print(m.y);
    Serial.print(", ");
    Serial.print(m.z);
    Serial.print(" / ");
    Serial.print(a.x);
    Serial.print(", ");
    Serial.print(a.y);
    Serial.print(", ");
    Serial.println(a.z);
  }
}